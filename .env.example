# Copy to .env (npm run setup does it) and fill in. Never commit .env.

# --- AI provider (any OpenAI-compatible API) -------------------------------------
# OpenRouter: https://openrouter.ai/api/v1   Groq: https://api.groq.com/openai/v1
# Ollama (local): http://localhost:11434/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_CHAT_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Must match the vector column in the database (see supabase/migrations).
AI_EMBEDDING_DIMENSIONS=1536
# Set to false for providers that reject the `dimensions` parameter (their native vector
# size must then equal AI_EMBEDDING_DIMENSIONS).
AI_EMBEDDING_SEND_DIMENSIONS=true
# Optional: use another provider for embeddings than for chat (e.g. a local Ollama).
# AI_EMBEDDING_BASE_URL=http://localhost:11434/v1
# AI_EMBEDDING_API_KEY=ollama
# Optional tuning.
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2

# --- Supabase ----------------------------------------------------------------------
# Only needed to apply migrations with the Supabase CLI (account settings -> access tokens).
SUPABASE_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Apps ----------------------------------------------------------------------------
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
